# Copy this file to .env and replace every placeholder before starting production.
MYSQL_DATABASE=smartdesk
DB_USERNAME=smartdesk
DB_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-separate-strong-root-password
JWT_SECRET=replace-with-a-random-64-character-secret
GROQ_API_KEY=replace-with-your-groq-api-key
GMAIL_USERNAME=replace-with-your-smtp-username
GMAIL_APP_PASSWORD=replace-with-your-smtp-app-password
APP_FRONTEND_URL=http://localhost
APP_PORT=80