# Local backend configuration. Copy to .env and replace placeholders.
DB_URL=jdbc:mysql://localhost:3306/smartdesk?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=Asia/Jerusalem&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=replace-with-your-local-database-password
JWT_SECRET=replace-with-a-random-64-character-secret
GROQ_API_KEY=replace-with-your-groq-api-key
GMAIL_USERNAME=replace-with-your-smtp-username
GMAIL_APP_PASSWORD=replace-with-your-smtp-app-password
APP_FRONTEND_URL=http://localhost:5173
